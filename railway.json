{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "buildCommand": "cd frontend && npm install && npm run build && cp -r dist ../backend/static"
    },
    "deploy": {
        "startCommand": "cd backend && uvicorn main:app --host 0.0.0.0 --port $PORT"
    }
}