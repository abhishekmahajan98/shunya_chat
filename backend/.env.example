FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for OAuth redirect_uri). Must match where the backend listens.
API_PUBLIC_URL=http://localhost:8000

# Supabase — leave blank to use in-memory store for local hacking
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key

# Dummy signed-in user (auth comes later)
DUMMY_USER_ID=00000000-0000-4000-8000-000000000001
DUMMY_USER_EMAIL=demo@shunya.local
DUMMY_USER_NAME=Demo User

# Encrypts OAuth / API-key credentials at rest (any long random string). Required in production.
INTEGRATIONS_ENCRYPTION_KEY=

# LLM — Google AI Studio key goes here
GOOGLE_API_KEY=your_google_ai_studio_key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=your_perplexity_api_key
PERPLEXITY_MODEL=sonar
MODEL=google_genai:gemini-3.8-flash
# MODEL_BASE_URL=   # optional, e.g. Ollama
